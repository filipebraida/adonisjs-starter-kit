{
  "name": "adonisjs-starter-kit",
  "version": "0.0.2",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint --continue --ui=stream --log-order=grouped",
    "format": "turbo format --continue --ui=stream --log-order=grouped",
    "typecheck": "turbo typecheck --continue --ui=stream --log-order=grouped",
    "test": "turbo test --continue --ui=stream",
    "ace": "pnpm --filter web exec node ace",
    "infra:up": "docker compose --env-file apps/web/.env up -d",
    "infra:down": "docker compose --env-file apps/web/.env down",
    "deploy:ship": "pnpm build && cata deploy",
    "deploy:run": "cata deploy",
    "deploy:setup": "cata deploy:setup",
    "deploy:rollback": "cata rollback",
    "deploy:status": "cata status",
    "deploy:list": "cata list:releases",
    "deploy:reload": "cata task pm2:reload",
    "deploy:logs": "cata task pm2:logs"
  },
  "devDependencies": {
    "@catapultjs/deploy": "^0.17.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.10.1",
    "turbo": "^2.11.11",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  }
}
