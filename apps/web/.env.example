TZ=UTC
PORT=3333
HOST=localhost
APP_NAME=AdonisJS Starter Kit
APP_URL=http://${HOST}:${PORT}
LOG_LEVEL=info
DRIVE_DISK=fs
APP_KEY=
NODE_ENV=development
SESSION_DRIVER=cookie

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=app

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Only needed when mail is sent through the resend mailer.
RESEND_API_KEY=
EMAIL_FROM=admin@repo.com

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=user@host.com
SMTP_PASSWORD='XXX'
SMTP_SECURE=0
SMTP_REJECTUNAUTHORIZED=false

GOOGLE_CLIENT_ID=<your-key>
GOOGLE_CLIENT_SECRET=<your-key>

# Extra hosts allowed to reach the dev server by another name (e.g. machine.local), comma-separated.
# To accept connections from outside the machine, also set HOST=0.0.0.0.
VITE_ALLOWED_HOSTS=
LIMITER_STORE=database