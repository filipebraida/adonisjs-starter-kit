{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "pnpm test:prepare && node ace test",
    "test:prepare": "NODE_ENV=test node ace db:prepare-test",
    "coverage": "pnpm test:prepare && c8 --reporter=text --reporter=lcov --extension=ts node ace test",
    "coverage:html": "pnpm test:prepare && c8 --reporter=text --reporter=html --reporter=lcov --extension=ts node ace test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit --project app/core/ui/tsconfig.json"
  },
  "imports": {
    "#app/*": "./app/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js",
    "#core/*": "./app/core/*.js",
    "#auth/*": "./app/auth/*.js",
    "#users/*": "./app/users/*.js",
    "#marketing/*": "./app/marketing/*.js",
    "#analytics/*": "./app/analytics/*.js",
    "#notifications/*": "./app/notifications/*.js",
    "#help/*": "./app/help/*.js",
    "#providers/*": "./providers/*.js",
    "#tests/*": "./tests/*.js",
    "#generated/*": "./.adonisjs/server/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.6.0",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@faker-js/faker": "^10.6.0",
    "@filipebraida/eslint-config-adonis": "^0.6.0",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.4.0",
    "@poppinss/file-generator": "^2.1.6",
    "@poppinss/ts-exec": "^1.5.2",
    "@tailwindcss/vite": "^4.3.5",
    "@tuyau/utils": "^0.0.9",
    "@types/luxon": "^3.7.6",
    "@types/mdast": "4.0.4",
    "@types/node": "~26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sinon": "^22.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "c8": "^12.0.0",
    "eslint": "^10.14.0",
    "hot-hook": "^1.1.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "sinon": "^22.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonis-agora/authz": "^0.20.2",
    "@adonis-agora/authz-react": "^0.3.1",
    "@adonis-agora/durable": "^0.60.0",
    "@adonisjs/ally": "^6.3.2",
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/bouncer": "^4.0.1",
    "@adonisjs/content": "1.7.1",
    "@adonisjs/core": "^7.6.0",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/drive": "^4.0.0",
    "@adonisjs/i18n": "^3.0.1",
    "@adonisjs/inertia": "^5.0.5",
    "@adonisjs/limiter": "^3.0.1",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/mail": "^10.4.0",
    "@adonisjs/session": "^8.3.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.1",
    "@adonisjs/transmit": "^3.0.2",
    "@adonisjs/transmit-client": "^1.1.0",
    "@adonisjs/vite": "^6.0.4",
    "@facteurjs/adonisjs": "2.1.0",
    "@filipebraida/adonis-auditing": "^2.0.0",
    "@inertiajs/core": "^3.11.0",
    "@inertiajs/react": "^3.11.0",
    "@jrmc/adonis-attachment": "^5.2.1",
    "@radix-ui/react-direction": "^1.2.0",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@tuyau/client": "^0.2.10",
    "@tuyau/core": "^1.3.0",
    "@vinejs/vine": "^4.4.0",
    "@workspace/ui": "workspace:*",
    "adonis-inertia-modal": "1.0.0",
    "axios": "^1.21.1",
    "edge.js": "^6.5.1",
    "github-slugger": "2.0.0",
    "i18next": "^26.3.4",
    "i18next-icu": "^2.7.0",
    "lucide-react": "^1.72.0",
    "luxon": "^3.7.2",
    "mdast-util-to-string": "4.0.0",
    "mermaid": "12.2.0",
    "mjml": "^5.4.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.8",
    "react-markdown": "10.1.0",
    "recharts": "3.10.1",
    "reflect-metadata": "^0.2.2",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-github-blockquote-alert": "2.1.0",
    "remark-parse": "11.0.0",
    "sharp": "^0.35.5",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "usehooks-ts": "^3.1.1"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "prettier": "@adonisjs/prettier-config",
  "c8": {
    "all": true,
    "include": [
      "app/**/*.ts"
    ],
    "exclude": [
      "app/**/tests/**",
      "app/**/database/factories/**",
      "app/**/database/migrations/**",
      "app/**/database/seeders/**",
      "app/**/ui/**",
      "app/**/resources/**",
      "app/**/types/**",
      "app/core/hooks/**",
      "app/**/*.d.ts"
    ]
  }
}
